{
  "name": "hackathon-battle-arena",
  "version": "1.0.0",
  "description": "AI-powered competitive hackathon matchmaking backend",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "test": "bun test",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:seed": "bunx prisma db seed",
    "prisma:studio": "bunx prisma studio"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "ioredis": "^5.4.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.7.2",
    "bun-types": "latest"
  }
}
