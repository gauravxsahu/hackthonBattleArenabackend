# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/hackathon_battle_arena?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT secrets - generate strong random values, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI provider key (used by AIChallengeService / AIEvaluationService)
AI_API_KEY="your_openai_api_key_here"
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_MODEL="gpt-5.4-mini"

# App
CLIENT_URL="http://localhost:5173"
PORT=4000
NODE_ENV="development"

# Game tuning
GAME_DURATION_MINUTES=30
MATCH_TEAM_SIZE=2
MATCH_PLAYERS_REQUIRED=4
